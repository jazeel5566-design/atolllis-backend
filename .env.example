# Local development points at a Neon DEV branch, never at production. Production's URLs live only
# in Render's environment settings.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# The same branch without the connection pooler ("-pooler" removed from the host); Prisma migration
# commands use it. Render needs its own production DIRECT_URL too.
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"
# Tests and scripts refuse to touch any branch except this one (Neon console: Branches → dev).
DEV_BRANCH_ID="br-XXXX"

# Change this before deploying anywhere real.
JWT_SECRET="change-this-secret-in-production"

PORT=4000
