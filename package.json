{
  "name": "atoll-lis-backend",
  "version": "1.0.0",
  "private": true,
  "description": "AtollLIS backend — multi-tier Laboratory Information System API (memo import, sample collection, referral, analyser interface, validation, reporting).",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "prisma:generate": "prisma generate",
    "migrate:new": "prisma migrate dev --create-only",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "seed": "node prisma/seed.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "prisma": "^5.18.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "fsevents@2.3.3": true
  }
}
